loadstring(game:HttpGet("https://cdn.luaprotect.dev/u/82d516/994AH8VIp0DT9FTl"))()

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if typeof(setclipboard) == "function" then
    setclipboard("https://t.me/scrips_saifx")
end

local gui = Instance.new("ScreenGui")
gui.Name = "SaifXNotice"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.Parent = playerGui

local text = Instance.new("TextLabel")
text.BackgroundTransparency = 1
text.Size = UDim2.new(1, -20, 0, 40)
text.Position = UDim2.new(0, 10, 0, 55)
text.Text = "تم نسخ رابط المفتاح، جاهز في القناة"
text.TextColor3 = Color3.fromRGB(255, 255, 255)
text.TextSize = 17
text.Font = Enum.Font.GothamBold
text.TextStrokeTransparency = 0.5
text.TextWrapped = true
text.Parent = gui

local tween = TweenService:Create(
    text,
    TweenInfo.new(10, Enum.EasingStyle.Linear),
    {
        Position = UDim2.new(0, 10, 0, -50),
        TextTransparency = 1,
        TextStrokeTransparency = 1
    }
)

tween:Play()
tween.Completed:Wait()
gui:Destroy()
